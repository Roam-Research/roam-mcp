{
  "name": "@roam-research/roam-tools-core",
  "version": "0.7.2",
  "description": "Official transport-agnostic core for Roam Research MCP and CLI tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roam-Research/roam-tools.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepublishOnly": "npm run --prefix ../.. build",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": ">=1.26.0 <2.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  }
}
