{
  "name": "@roam-research/roam-mcp",
  "version": "0.7.4",
  "description": "Official MCP server for Roam Research — connect Claude and other AI assistants to your graph",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roam-Research/roam-tools.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "roam-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "keywords": [
    "roam",
    "roam-research",
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "llm",
    "ai-agents"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepublishOnly": "npm run --prefix ../.. build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": ">=1.26.0 <2.0.0",
    "@roam-research/roam-tools-local": "0.7.4"
  }
}
